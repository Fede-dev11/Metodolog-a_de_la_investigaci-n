	pages = {1500 - 1506},
	doi = {10.1109/ICISC65841.2025.11188129},
	url = {https://www.scopus.com/pages/publications/105020963533?origin=resultslist},
	abstract = {Conversational agents (CAs) have developed leaps and bounds with the progress in deep learning and natural language processing (NLP). Conventional supervised learning-based methods are unsuitable for managing dynamic and multi-turn conversation, producing suboptimal user experiences with poor contextual responsiveness and long-term conversation. Reinforcement learning (RL) emerges as a promising framework for improving CAs by facilitating adaptive learning, dialogue strategy optimization, and user satisfaction improvement through reward-guided optimization. The recent RL methods of conversational AI are reviewed herein, such as policy learning, reward modelling, hierarchical reinforcement learning, and multi-agent reinforcement learning. Policy learning methods like DQNs and policy gradient approaches enable agents to learn dialogue strategy through interactive optimization. Reward modelling is essential to create significant feedback mechanisms using human-in-the-loop learning, while inverse reinforcement learning is used for learning implicit user preferences. Hierarchical RL arranges conversation by stacking many decision-making layers that improve scalability as well as cohesion in multi-stage dialogues. Multi-agent RL takes it a step further by enabling interactions between conversational agents with multiple entities interacting with one another, facilitating collaboration as well as competition and optimizing learning efficiency. There exist numerous challenges yet to be fully addressed by the promise of RL-based CAs, including sparsity of reward, sample inefficiency, real-world deployment, and ethics. Future work then needs to look into data efficiency, developing informative metrics for evaluating performance, as well as reasoning in a natural way to result in more realistic-sounding discourse. Addressing these, conversational agents with RL can redefine humancomputer interaction and result in more adaptable, context-rich, and fun dialogue systems in many applications. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

